{
  "name": "project-battleship-the-odin-project",
  "version": "1.0.0",
  "description": "Battleship from The Odin Project's JavaScript path: a Test Driven Development build of the classic game against the computer, bundled with webpack.",
  "main": "src/index.js",
  "scripts": {
    "build": "webpack --config webpack.prod.js",
    "start": "webpack serve --config webpack.dev.js",
    "preview": "webpack serve --config webpack.prod.js",
    "deploy": "npm run build && gh-pages -d dist -m \"deploy: publish the production build\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w3nc/Project-Battleship-The-Odin-Project.git"
  },
  "keywords": [
    "battleship",
    "test-driven-development",
    "jest",
    "webpack",
    "the-odin-project"
  ],
  "bugs": {
    "url": "https://github.com/w3nc/Project-Battleship-The-Odin-Project/issues"
  },
  "homepage": "https://github.com/w3nc/Project-Battleship-The-Odin-Project#readme",
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@eslint/js": "^10.0.1",
    "babel-jest": "^30.5.2",
    "css-loader": "^7.0.0",
    "eslint": "^10.11.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.12.0",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "3.9.8",
    "style-loader": "^4.0.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^6.0.0",
    "webpack-dev-server": "^5.0.0",
    "webpack-merge": "^6.0.1"
  }
}
